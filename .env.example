# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=regulatory-docs

# API / frontend
APP_BASE_URL=https://regulatory-ai-web-5bbc.vercel.app
API_BASE_URL=https://regai-api-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://regai-api-production.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=https://regai-api-production.up.railway.app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://regulatory-ai-web-5bbc.vercel.app
CORS_ORIGIN_REGEX="^https://regulatory-ai-web-5bbc(?:-[a-z0-9-]+)?\\.vercel\\.app$"

# First-party identity (parallel to Supabase Auth; use independent 32+ byte secrets)
IDENTITY_JWT_SIGNING_KEY=
IDENTITY_TOKEN_PEPPER=
IDENTITY_JWT_KEY_ID=identity-v1
IDENTITY_JWT_VERIFICATION_KEYS={}
IDENTITY_JWT_ISSUER=resolven-identity
IDENTITY_JWT_AUDIENCE=resolven-api
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
IDENTITY_SESSION_TTL_SECONDS=2592000
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_SAMESITE=lax
IDENTITY_COOKIE_DOMAIN=
IDENTITY_TRUST_FORWARDED_FOR=false
IDENTITY_EXCHANGE_RATE_LIMIT=3
IDENTITY_EXCHANGE_RATE_WINDOW_SECONDS=3600

# LLM
LLM_PROVIDER=parallel
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
LLM_MODEL_AGENT=base
LLM_MODEL_SUMMARY=base
LLM_MODEL_CHAT=speed

# Hybrid RAG
EMBEDDING_PROVIDER=offline
VECTOR_PROVIDER=supabase
RETRIEVAL_PROVIDER=supabase
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
RAG_CHUNK_MIN_TOKENS=600
RAG_CHUNK_MAX_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_CONTEXT_TOKEN_LIMIT=6500
RAG_TOP_K=15

# Ask AI rollout controls (all default off)
ASK_AI_V2_WRITE_ENABLED=false
ASK_AI_V2_API_ENABLED=false
ASK_AI_DECISION_ENGINE_ENABLED=false
ASK_AI_ORCHESTRATOR_ENABLED=false
ASK_AI_GENERAL_MODE_ENABLED=false
ASK_AI_LIVE_MODE_ENABLED=false
ASK_AI_VERIFICATION_ENABLED=false
ASK_AI_STREAMING_ENABLED=false
ASK_AI_V2_UI_ENABLED=false
NEXT_PUBLIC_ASK_AI_V2_UI_ENABLED=false
VITE_ASK_AI_V2_UI_ENABLED=false

# Email
EMAIL_PROVIDER=offline
EMAIL_API_KEY=
EMAIL_FROM="Regulatory AI <updates@example.com>"

# Ops
SENTRY_DSN=
CRAWL_USER_AGENT="RegulatoryAI-bot/0.1 (+https://example.com/bot)"
